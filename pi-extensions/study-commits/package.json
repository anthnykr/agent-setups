{
  "name": "@anthnykr/pi-study-commits",
  "version": "0.1.0",
  "description": "Pi extension for selecting recent git commits and injecting their diffs into the conversation.",
  "type": "module",
  "license": "MIT",
  "author": "Anthony Kroeger",
  "repository": {
    "type": "git",
    "url": "https://github.com/anthnykr/agent-setups.git",
    "directory": "pi-extensions/study-commits"
  },
  "homepage": "https://github.com/anthnykr/agent-setups/tree/main/pi-extensions/study-commits#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "git",
    "commits"
  ],
  "files": [
    "extensions",
    "study-commits.ts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "0.60.0",
    "@mariozechner/pi-tui": "0.60.0",
    "@types/node": "25.5.0",
    "eslint": "10.0.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1"
  },
  "scripts": {
    "lint": "eslint --fix study-commits.ts extensions/**/*.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  }
}
